PORT=8787
DATA_DIR=./.data
# Mobil uygulamanın sunucuya erişebilmesi için (yerelde bilgisayarın LAN IP'si)
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGIN=*

# Bildirim taraması (milisaniye). 300000 = 5 dakika
SCAN_INTERVAL_MS=300000
# İlk açılışta taramayı ne kadar geciktirelim
SCAN_START_DELAY_MS=8000
DISABLE_SCHEDULER=0

# On-demand arama sonuçlarını önbellekleme süresi
SEARCH_CACHE_MS=600000

# /api/scan endpoint'i için gizli anahtar (boşsa endpoint kapalı)
SCAN_TOKEN=

# Firebase Admin service account JSON'u.
# Ya JSON'un kendisini ya da base64 halini yaz. Boşsa sadece uygulama içi bildirimler çalışır.
FIREBASE_SERVICE_ACCOUNT=
# Örnek:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Log seviyesi: fatal | error | warn | info | debug | trace
LOG_LEVEL=info